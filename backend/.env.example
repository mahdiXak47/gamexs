DJANGO_SETTINGS_MODULE=gamexs.settings.local
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=gamexs
POSTGRES_USER=gamexs
POSTGRES_PASSWORD=gamexs
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

FRONTEND_URL=http://localhost:3000

# JWT auth cookies. Production overrides JWT_COOKIE_SECURE=True in settings,
# but these names/SameSite policy can be changed if the deployment topology changes.
JWT_ACCESS_COOKIE_NAME=gx_access
JWT_REFRESH_COOKIE_NAME=gx_refresh
JWT_COOKIE_SAMESITE=Lax

# SMS provider: 'console' (dev) or 'smsir' (production)
# Get API key from https://app.sms.ir/developer
# Create a verify template in the panel, set the template ID below
SMS_BACKEND=console
SMS_API_KEY=
SMS_TEMPLATE_ID=

PYTHONUNBUFFERED=1

# Production only
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@gamexs.ir
# CORS_ALLOWED_ORIGINS=https://gamexs.ir
