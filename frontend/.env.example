# Copy to .env.local for local development (Docker container at port 5434).
# In production (Kubernetes), set DATABASE_URL as a Secret env var.
#
# Local dev:
DATABASE_URL=postgresql://gamexs:gamexs@localhost:5434/gamexs
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: POST Core Web Vitals payloads to an external analytics collector.
# Leave blank to use the built-in self-hosted sink (/api/web-vitals, stored in
# the shared `web_vitals` Postgres table).
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
# Set only after confirming comparison-site eligibility with Google Merchant Center.
MERCHANT_FEED_ENABLED=false
# Set to true when local network/proxy constraints prevent Next from fetching
# S3/IGDB images through the image optimizer.
NEXT_IMAGE_UNOPTIMIZED=true
#
# Production (k8s svc):
# DATABASE_URL=postgresql://gamexs:gamexs@gamexs-db.mahdixak-gamexs.svc:5432/gamexs
# NEXT_PUBLIC_API_URL=https://api.gamexs.ir
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=https://analytics.example.com/web-vitals
